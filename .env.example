# =============================================================================
# FinancEZ - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual keys
# DO NOT commit .env to version control!
# cp .env.example .env

# =============================================================================
# Django Configuration
# =============================================================================
# Django secret key for cryptographic signing
SECRET_KEY=django-insecure-dev-key-change-in-production
# Enable debug mode (True/False)
DEBUG=True
# Comma-separated allowed hosts for Django
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# JWT Configuration (shared with Flask microservices)
# =============================================================================
# Secret key for signing JWT tokens (must be same across Django and Flask)
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key
# Algorithm for JWT signing (HS256)
JWT_ALGORITHM=HS256
# Access token lifetime in seconds (default 1200 = 20 minutes)
JWT_ACCESS_TOKEN_EXPIRES_IN=1200

# =============================================================================
# LLM Configuration (for AI Feedback via Groq)
# =============================================================================
# LLM provider (groq)
LLM_PROVIDER=groq
# Groq API key (get from https://console.groq.com/keys)
LLM_API_KEY=gsk_your_groq_api_key_here
# Model name - must be a model that the API key can list (GET https://api.groq.com/openai/v1/models)
LLM_MODEL=openai/gpt-oss-20b